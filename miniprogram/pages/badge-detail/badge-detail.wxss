.detail-page { padding-top: 32rpx; }
.detail-header { padding-bottom: 28rpx; }
.detail-title { font-size: 44rpx; line-height: 1.3; }
.detail-header .meta { margin-top: 12rpx; }
.stage { position: relative; overflow: hidden; border: 2rpx solid var(--line); border-radius: 28rpx; background: #f3f7f2; touch-action: none; }
.stage-mask { position: absolute; left: 0; top: 0; display: flex; width: 100%; height: 100%; flex-direction: column; align-items: center; justify-content: center; padding: 48rpx; background: rgba(243, 247, 242, 0.92); color: var(--ink); text-align: center; }
.mask-text { font-size: 29rpx; font-weight: 500; }
.mask-hint { margin-top: 12rpx; font-size: 24rpx; }
.detail-actions { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 28rpx; }
.detail-hint { margin-top: 20rpx; font-size: 24rpx; }
