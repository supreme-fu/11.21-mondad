.badges-header { padding-bottom: 40rpx; border-bottom: 2rpx solid var(--line); }
.badges-title { margin: 16rpx 0 20rpx; font-size: 52rpx; line-height: 1.3; }
.badge-group { padding: 40rpx 0; border-bottom: 2rpx solid var(--line); }
.badge-group-head { margin-bottom: 28rpx; }
.group-title { font-size: 36rpx; }
.group-note { margin-top: 8rpx; font-size: 24rpx; }
.badge-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24rpx; }
.badge-card { display: flex; flex-direction: column; padding: 20rpx; border: 2rpx solid var(--line); border-radius: 28rpx; background: var(--card); }
.badge-card-hover { border-color: var(--accent); }
.badge-thumb { width: 100%; aspect-ratio: 1 / 1; border-radius: 20rpx; background: #eef3ec; }
.badge-name { margin-top: 16rpx; font-size: 27rpx; font-weight: 500; line-height: 1.35; }
.badge-series { margin-top: 6rpx; font-size: 21rpx; line-height: 1.35; }
.badges-note { padding: 44rpx 0 8rpx; }
.note-title { margin: 16rpx 0 20rpx; font-size: 40rpx; line-height: 1.35; }

@media (min-width: 600px) {
  .badge-grid { grid-template-columns: repeat(3, 1fr); gap: 32rpx; }
}
