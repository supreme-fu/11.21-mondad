.declare-glyph { width: 144rpx; height: 144rpx; margin: 48rpx 0 32rpx; font-size: 52rpx; }
.declare-title { margin-top: 24rpx; font-size: 62rpx; line-height: 1.3; white-space: pre-line; }
.declare-copy { margin-top: 28rpx; }
.declare-panel { margin-top: 48rpx; padding: 36rpx; border: 2rpx solid var(--line); border-radius: 30rpx; background: var(--card); }
.declare-panel-title { font-size: 36rpx; line-height: 1.45; }
.declare-panel .muted { margin-top: 20rpx; }
.declare-button { margin-top: 32rpx; }
.declare-note { margin-top: 20rpx; color: var(--muted); font-size: 23rpx; }
.complete-title { margin-top: 32rpx; font-size: 60rpx; line-height: 1.3; }
.complete-copy { margin: 24rpx 0 40rpx; }
.echo-panel { padding: 40rpx 32rpx; border-radius: 30rpx; background: #203f32; color: #f3f7f2; }
.echo-eyebrow { color: #d8e4d9; font-size: 24rpx; }
.echo-title { margin-top: 20rpx; font-size: 39rpx; line-height: 1.45; }
.echo-quote { margin-top: 32rpx; font-family: Georgia, "Songti SC", serif; font-size: 33rpx; line-height: 1.75; }
.echo-author { margin-top: 24rpx; font-size: 25rpx; }
.example-badge { margin-left: 16rpx; padding: 4rpx 14rpx; border-radius: 999rpx; background: #e9f0e7; color: #203f32; font-size: 21rpx; }
.echo-boundary { margin-top: 32rpx; color: #d8e4d9; font-size: 22rpx; }
.echo-empty, .echo-loading { margin-top: 28rpx; }
.form-panel { margin-top: 32rpx; padding: 36rpx 28rpx; border: 2rpx solid var(--line); border-radius: 30rpx; background: var(--card); }
.panel-title { margin-top: 16rpx; font-size: 40rpx; }
.count { margin-top: 8rpx; color: var(--muted); font-size: 22rpx; text-align: right; }
.share-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 28rpx; }
.share-copy { flex: 1; font-size: 27rpx; }
.share-copy .muted { margin-top: 8rpx; font-size: 22rpx; }
.receipt-status { margin-top: 28rpx; }
.receipt-copy { margin: 24rpx 0; font-size: 26rpx; }
.receipt-id { display: flex; flex-direction: column; gap: 8rpx; padding: 24rpx 0; border-top: 2rpx solid var(--line); font-size: 23rpx; word-break: break-all; }
.receipt-button { margin-top: 28rpx; }
.consent { margin-bottom: 12rpx; }
.deletion-note { padding: 40rpx 0; color: var(--muted); font-size: 24rpx; }
.reading-lab-panel { border-color: #9cb5a5; }
.reading-summary-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; flex-wrap: wrap; }
.reading-earned { font-size: 28rpx; font-weight: 600; color: #315c47; }
.reading-progress-bar { margin-top: 16rpx; height: 14rpx; border-radius: 999rpx; background: #e8eee9; overflow: hidden; }
.reading-progress-fill { height: 100%; background: #315c47; border-radius: 999rpx; }
.reading-presets { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.reading-preset-btn { margin: 0; font-size: 22rpx; }
.reading-claim-block { margin-top: 20rpx; display: flex; flex-direction: column; gap: 12rpx; }
