# 复制为根目录 .env 后填写；.env 已被 .gitignore 排除，禁止提交真实私钥。
# 服务端与合约脚本都从根目录 .env 读取，环境变量中已有的值优先。

# —— 服务端 ——
# 演示默认本地模拟；只有准备真实上链时才改成 monad-testnet。
# 模拟模式只在本地 SQLite 里记录凭证编号，不产生任何链上交易。
RECEIPT_MODE=simulation
PORT=7100
# DATABASE_PATH=server/data/do-something.db

# —— Monad 测试网（官方参数）——
# Chain ID 10143，浏览器 https://testnet.monadvision.com
MONAD_CHAIN_ID=10143
# 部署返回的 CompletionReceipt 合约地址
MONAD_CONTRACT_ADDRESS=
# 仅服务端读取的专用测试私钥，不使用真实资产钱包
MONAD_TESTNET_PRIVATE_KEY=
MONAD_EXPLORER_URL=https://testnet.monadvision.com

# RPC：官方地址 https://testnet-rpc.monad.xyz 在部分地区返回
# {"code":-32002,"message":"blocked: restricted region"}（2026-11-10 实测）。
# 可选公共替代（只读可用，实测 eth_chainId 返回 0x279f = 10143）：
# MONAD_RPC_URL=https://rpc.ankr.com/monad_testnet
# 不填则使用官方地址；链 ID 只认 10143，填错服务端会拒绝启动。

# —— 本地 EVM 联调（scripts/test-evm-provider.mjs 自动注入，无需手填）——
# LOCAL_EVM_RPC_URL=http://127.0.0.1:8545

# 使用公开测试网共读部署记录时解除下一行注释。签名钱包必须与记录中的 attestor 一致。
# FORK_READING_DEPLOYMENT_PATH=contracts/deployments/fork-reading-monad-testnet.json
